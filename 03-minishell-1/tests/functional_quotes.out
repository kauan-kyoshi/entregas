minishell$ VARX=world
minishell$ echo "double quotes $VARX"
Command 0:
  argv[0] = echo
  argv[1] = double quotes world
minishell$ echo 'single quotes $VARX'
Command 0:
  argv[0] = echo
  argv[1] = single quotes $VARX
minishell$ echo mixed"$VARX"end
Command 0:
  argv[0] = echo
  argv[1] = mixedworldend
minishell$ exit
Command 0:
  argv[0] = exit
minishell$ 